Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: nav2_rviz_plugins/Navigation 2
    Name: Navigation 2
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Cell Size: 1
      Plane Cell Count: 50
    - Class: rviz_default_plugins/Map
      Name: Map
      Enabled: true
      Alpha: 0.7
      Topic: {Value: /map, Durability Policy: Transient Local, Reliability Policy: Reliable}
    - Class: rviz_default_plugins/Map
      Name: Keepout Zones
      Enabled: true
      Alpha: 0.5
      Topic: {Value: /mooncar/terrain/keepout, Durability Policy: Transient Local}
    - Class: rviz_default_plugins/Map
      Name: Local Costmap
      Enabled: true
      Alpha: 0.4
      Color Scheme: costmap
      Topic: {Value: /local_costmap/costmap, Durability Policy: Transient Local}
    - Class: rviz_default_plugins/Path
      Name: Global Plan
      Enabled: true
      Color: 40; 210; 130
      Line Width: 0.03
      Topic: {Value: /plan, Reliability Policy: Reliable}
    - Class: rviz_default_plugins/LaserScan
      Name: Laser
      Enabled: true
      Size (Pixels): 2
      Topic: {Value: /mooncar/scan, Reliability Policy: Best Effort}
    - Class: rviz_default_plugins/PointCloud2
      Name: Terrain Hazards
      Enabled: true
      Size (Pixels): 6
      Color Transformer: FlatColor
      Color: 255; 100; 30
      Topic: {Value: /mooncar/terrain/obstacles}
    - Class: rviz_default_plugins/RobotModel
      Name: Rover
      Enabled: true
      Description Topic: {Value: /robot_description, Durability Policy: Transient Local}
  Enabled: true
  Global Options: {Fixed Frame: map, Frame Rate: 15, Background Color: '28; 30; 34'}
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/SetInitialPose
      Topic: /initialpose
    - Class: nav2_rviz_plugins/GoalTool
  Views:
    Current: {Class: rviz_default_plugins/TopDownOrtho, Scale: 35, Target Frame: map}
Window Geometry: {Height: 900, Width: 1200}
