    </model>

    <model name="navigation_rock_field">
      <static>true</static>
      <link name="west_south">
        <pose>-3 -2.5 0.4 0 0 0.3</pose>
        <collision name="collision"><geometry><ellipsoid><radii>0.7 0.45 0.65</radii></ellipsoid></geometry></collision>
        <visual name="visual">
          <geometry><ellipsoid><radii>0.7 0.45 0.65</radii></ellipsoid></geometry>
          <material><ambient>0.28 0.29 0.30 1</ambient><diffuse>0.38 0.39 0.40 1</diffuse></material>
        </visual>
      </link>
      <link name="west_north">
        <pose>-3 3.5 0.5 0 0 -0.5</pose>
        <collision name="collision"><geometry><ellipsoid><radii>0.5 0.7 0.8</radii></ellipsoid></geometry></collision>
        <visual name="visual">
          <geometry><ellipsoid><radii>0.5 0.7 0.8</radii></ellipsoid></geometry>
          <material><ambient>0.23 0.25 0.27 1</ambient><diffuse>0.33 0.35 0.37 1</diffuse></material>
        </visual>
