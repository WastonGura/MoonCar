<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:macro name="mooncar_gazebo_drive" params="prefix wheel_radius wheel_separation">
    <gazebo>
      <plugin
        filename="gz-sim-diff-drive-system"
        name="gz::sim::systems::DiffDrive">
        <left_joint>${prefix}front_left_wheel_joint</left_joint>
        <left_joint>${prefix}rear_left_wheel_joint</left_joint>
        <right_joint>${prefix}front_right_wheel_joint</right_joint>
        <right_joint>${prefix}rear_right_wheel_joint</right_joint>
        <wheel_separation>${wheel_separation}</wheel_separation>
        <wheel_radius>${wheel_radius}</wheel_radius>
        <max_linear_acceleration>0.5</max_linear_acceleration>
        <min_linear_acceleration>-0.5</min_linear_acceleration>
        <max_angular_acceleration>1.0</max_angular_acceleration>
        <min_angular_acceleration>-1.0</min_angular_acceleration>
        <max_linear_velocity>0.35</max_linear_velocity>
        <min_linear_velocity>-0.35</min_linear_velocity>
        <max_angular_velocity>0.8</max_angular_velocity>
        <min_angular_velocity>-0.8</min_angular_velocity>
        <topic>/cmd_vel</topic>
        <odom_topic>/odom</odom_topic>
        <tf_topic>/tf</tf_topic>
        <frame_id>odom</frame_id>
        <child_frame_id>${prefix}base_footprint</child_frame_id>
        <odom_publish_frequency>30</odom_publish_frequency>
      </plugin>

      <plugin
        filename="gz-sim-joint-state-publisher-system"
        name="gz::sim::systems::JointStatePublisher">
        <joint_name>${prefix}front_left_wheel_joint</joint_name>
        <joint_name>${prefix}rear_left_wheel_joint</joint_name>
        <joint_name>${prefix}front_right_wheel_joint</joint_name>
        <joint_name>${prefix}rear_right_wheel_joint</joint_name>
        <topic>joint_states</topic>
        <update_rate>30</update_rate>
      </plugin>
    </gazebo>
  </xacro:macro>
</robot>
