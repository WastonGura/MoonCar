<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="mooncar">
  <xacro:arg name="prefix" default=""/>
  <xacro:arg name="use_sim_time" default="true"/>

  <xacro:include filename="$(find mooncar_description)/urdf/common/materials.xacro"/>
  <xacro:include filename="$(find mooncar_description)/urdf/common/inertial_macros.xacro"/>
  <xacro:include filename="$(find mooncar_description)/urdf/common/rover_macros.xacro"/>
  <xacro:include filename="$(find mooncar_description)/urdf/common/gazebo_sensors.xacro"/>
  <xacro:include filename="$(find mooncar_description)/urdf/common/gazebo_drive.xacro"/>

  <xacro:property name="prefix" value="$(arg prefix)"/>
  <xacro:property name="chassis_length" value="0.72"/>
  <xacro:property name="chassis_width" value="0.48"/>
  <xacro:property name="chassis_height" value="0.18"/>
  <xacro:property name="chassis_mass" value="12.0"/>
  <xacro:property name="chassis_ground_clearance" value="0.12"/>
  <xacro:property name="wheel_radius" value="0.16"/>
  <xacro:property name="wheel_width" value="0.11"/>
  <xacro:property name="wheel_mass" value="1.2"/>
  <xacro:property name="wheel_x_offset" value="0.26"/>
  <xacro:property name="wheel_y_offset" value="${chassis_width / 2.0 + wheel_width / 2.0}"/>
  <xacro:property name="wheel_separation" value="${2.0 * wheel_y_offset}"/>
  <xacro:property name="base_link_z_offset" value="${chassis_ground_clearance + chassis_height / 2.0}"/>
  <xacro:property name="wheel_z_offset" value="${wheel_radius - base_link_z_offset}"/>
  <xacro:property name="lidar_radius" value="0.055"/>
  <xacro:property name="lidar_height" value="0.045"/>
  <xacro:property name="lidar_mass" value="0.25"/>
  <xacro:property name="camera_length" value="0.075"/>
  <xacro:property name="camera_width" value="0.035"/>
  <xacro:property name="camera_height" value="0.035"/>
  <xacro:property name="camera_mass" value="0.18"/>
  <xacro:property name="imu_size" value="0.035"/>
  <xacro:property name="imu_mass" value="0.08"/>
  <xacro:property name="nav_reference_size" value="0.04"/>
  <xacro:property name="nav_reference_mass" value="0.05"/>

  <link name="${prefix}base_footprint"/>

  <joint name="${prefix}base_footprint_joint" type="fixed">
    <parent link="${prefix}base_footprint"/>
    <child link="${prefix}base_link"/>
    <origin xyz="0 0 ${base_link_z_offset}" rpy="0 0 0"/>
  </joint>

  <link name="${prefix}base_link">
    <visual name="lower_chassis">
      <origin xyz="0 0 -0.025" rpy="0 0 0"/>
      <geometry>
        <box size="${chassis_length} ${chassis_width} 0.13"/>
      </geometry>
      <material name="mooncar_dark_gray"/>
    </visual>
    <visual name="upper_equipment_deck">
      <origin xyz="-0.03 0 0.075" rpy="0 0 0"/>
      <geometry>
        <box size="0.54 0.36 0.07"/>
      </geometry>
      <material name="mooncar_panel_white"/>
    </visual>
    <visual name="top_service_panel">
      <origin xyz="-0.06 0 0.116" rpy="0 0 0"/>
      <geometry>
        <box size="0.28 0.25 0.012"/>
      </geometry>
      <material name="mooncar_sensor_blue"/>
    </visual>
    <visual name="left_frame_rail">
      <origin xyz="0 0.255 -0.035" rpy="0 0 0"/>
      <geometry>
        <box size="0.62 0.045 0.055"/>
      </geometry>
      <material name="mooncar_sensor_blue"/>
    </visual>
    <visual name="right_frame_rail">
      <origin xyz="0 -0.255 -0.035" rpy="0 0 0"/>
      <geometry>
        <box size="0.62 0.045 0.055"/>
      </geometry>
      <material name="mooncar_sensor_blue"/>
    </visual>
    <visual name="front_bumper">
      <origin xyz="0.385 0 -0.035" rpy="0 0 0"/>
      <geometry>
        <box size="0.05 0.54 0.065"/>
      </geometry>
      <material name="mooncar_hub_silver"/>
    </visual>
    <visual name="rear_bumper">
      <origin xyz="-0.385 0 -0.035" rpy="0 0 0"/>
      <geometry>
        <box size="0.05 0.54 0.065"/>
      </geometry>
      <material name="mooncar_hub_silver"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="${chassis_length} ${chassis_width} ${chassis_height}"/>
      </geometry>
    </collision>
    <xacro:box_inertial
      mass="${chassis_mass}"
      x="${chassis_length}"
      y="${chassis_width}"
      z="${chassis_height}">
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </xacro:box_inertial>
  </link>

  <xacro:skid_steer_wheel
    prefix="${prefix}"
    name="front_left_wheel"
    parent="base_link"
    x="${wheel_x_offset}"
    y="${wheel_y_offset}"
    z="${wheel_z_offset}"
    radius="${wheel_radius}"
    width="${wheel_width}"
    mass="${wheel_mass}"/>

  <xacro:skid_steer_wheel
    prefix="${prefix}"
    name="front_right_wheel"
    parent="base_link"
    x="${wheel_x_offset}"
    y="${-wheel_y_offset}"
    z="${wheel_z_offset}"
    radius="${wheel_radius}"
    width="${wheel_width}"
    mass="${wheel_mass}"/>

  <xacro:skid_steer_wheel
    prefix="${prefix}"
    name="rear_left_wheel"
    parent="base_link"
    x="${-wheel_x_offset}"
    y="${wheel_y_offset}"
    z="${wheel_z_offset}"
    radius="${wheel_radius}"
    width="${wheel_width}"
    mass="${wheel_mass}"/>

  <xacro:skid_steer_wheel
    prefix="${prefix}"
    name="rear_right_wheel"
    parent="base_link"
    x="${-wheel_x_offset}"
    y="${-wheel_y_offset}"
    z="${wheel_z_offset}"
    radius="${wheel_radius}"
    width="${wheel_width}"
    mass="${wheel_mass}"/>

  <link name="${prefix}lidar_link">
    <visual name="lidar_housing">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="${lidar_radius}" length="${lidar_height}"/>
      </geometry>
      <material name="mooncar_sensor_blue"/>
    </visual>
    <visual name="lidar_mount">
      <origin xyz="0 0 -0.045" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.027" length="0.07"/>
      </geometry>
      <material name="mooncar_hub_silver"/>
    </visual>
    <visual name="lidar_top_cap">
      <origin xyz="0 0 ${lidar_height / 2.0 + 0.006}" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="${lidar_radius * 0.82}" length="0.012"/>
      </geometry>
      <material name="mooncar_lens_black"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="${lidar_radius}" length="${lidar_height}"/>
      </geometry>
    </collision>
    <xacro:cylinder_inertial
      mass="${lidar_mass}"
      radius="${lidar_radius}"
      length="${lidar_height}"
      axis="z">
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </xacro:cylinder_inertial>
  </link>

  <joint name="${prefix}lidar_joint" type="fixed">
    <parent link="${prefix}base_link"/>
    <child link="${prefix}lidar_link"/>
    <origin xyz="0.14 0 ${chassis_height / 2.0 + lidar_height / 2.0}" rpy="0 0 0"/>
  </joint>

  <link name="${prefix}depth_camera_link">
    <visual name="camera_body">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="${camera_length} 0.10 0.055"/>
      </geometry>
      <material name="mooncar_light_gray"/>
    </visual>
    <visual name="camera_left_lens">
      <origin xyz="${camera_length / 2.0 + 0.006} 0.027 0" rpy="0 1.57079632679 0"/>
      <geometry>
        <cylinder radius="0.014" length="0.012"/>
      </geometry>
      <material name="mooncar_lens_black"/>
    </visual>
    <visual name="camera_right_lens">
      <origin xyz="${camera_length / 2.0 + 0.006} -0.027 0" rpy="0 1.57079632679 0"/>
      <geometry>
        <cylinder radius="0.014" length="0.012"/>
      </geometry>
      <material name="mooncar_lens_black"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="${camera_length} ${camera_width} ${camera_height}"/>
      </geometry>
    </collision>
    <xacro:box_inertial
      mass="${camera_mass}"
      x="${camera_length}"
      y="${camera_width}"
      z="${camera_height}">
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </xacro:box_inertial>
  </link>

  <joint name="${prefix}depth_camera_joint" type="fixed">
    <parent link="${prefix}base_link"/>
    <child link="${prefix}depth_camera_link"/>
    <origin xyz="${chassis_length / 2.0 + camera_length / 2.0} 0 0.025" rpy="0 0 0"/>
  </joint>

  <link name="${prefix}depth_camera_optical_frame"/>

  <joint name="${prefix}depth_camera_optical_joint" type="fixed">
    <parent link="${prefix}depth_camera_link"/>
    <child link="${prefix}depth_camera_optical_frame"/>
    <origin xyz="${camera_length / 2.0} 0 0" rpy="-1.57079632679 0 -1.57079632679"/>
  </joint>

  <link name="${prefix}imu_link">
    <visual name="imu_module">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="${imu_size} ${imu_size} ${imu_size}"/>
      </geometry>
      <material name="mooncar_warning_gold"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="${imu_size} ${imu_size} ${imu_size}"/>
      </geometry>
    </collision>
    <xacro:box_inertial
      mass="${imu_mass}"
      x="${imu_size}"
      y="${imu_size}"
      z="${imu_size}">
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </xacro:box_inertial>
  </link>

  <joint name="${prefix}imu_joint" type="fixed">
    <parent link="${prefix}base_link"/>
    <child link="${prefix}imu_link"/>
    <origin xyz="0 0 ${chassis_height / 2.0 + imu_size / 2.0}" rpy="0 0 0"/>
  </joint>

  <link name="${prefix}nav_reference_link">
    <visual name="antenna_base">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="${nav_reference_size} ${nav_reference_size} ${nav_reference_size}"/>
      </geometry>
      <material name="mooncar_warning_gold"/>
    </visual>
    <visual name="antenna_mast">
      <origin xyz="0 0 0.09" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.012" length="0.18"/>
      </geometry>
      <material name="mooncar_hub_silver"/>
    </visual>
    <visual name="antenna_head">
      <origin xyz="0 0 0.19" rpy="0 0 0"/>
      <geometry>
        <sphere radius="0.032"/>
      </geometry>
      <material name="mooncar_sensor_blue"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="${nav_reference_size} ${nav_reference_size} ${nav_reference_size}"/>
      </geometry>
    </collision>
    <xacro:box_inertial
      mass="${nav_reference_mass}"
      x="${nav_reference_size}"
      y="${nav_reference_size}"
      z="${nav_reference_size}">
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </xacro:box_inertial>
  </link>

  <joint name="${prefix}nav_reference_joint" type="fixed">
    <parent link="${prefix}base_link"/>
    <child link="${prefix}nav_reference_link"/>
    <origin xyz="-0.16 0 ${chassis_height / 2.0 + nav_reference_size / 2.0}" rpy="0 0 0"/>
  </joint>

  <xacro:mooncar_gazebo_sensors prefix="${prefix}"/>
  <xacro:mooncar_gazebo_drive
    prefix="${prefix}"
    wheel_radius="${wheel_radius}"
    wheel_separation="${wheel_separation}"/>
</robot>
