<sdf version="1.10">
  <world name="lunar_yard">
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics" />
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands" />
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster" />
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu" />

    <physics name="mooncar_physics" type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>

    <gravity>0 0 -1.62</gravity>

    <gui fullscreen="0">
      <plugin filename="MinimalScene" name="3D View">
        <gz-gui>
          <title>3D View</title>
          <property type="bool" key="showTitleBar">false</property>
          <property type="string" key="state">docked</property>
        </gz-gui>
        <engine>ogre</engine>
        <scene>scene</scene>
        <ambient_light>0.38 0.39 0.42</ambient_light>
        <background_color>0.94 0.94 0.94</background_color>
        <camera_pose>10 -12 13 0 0.70 2.15</camera_pose>
        <camera_clip>
          <near>0.08</near>
          <far>200</far>
        </camera_clip>
      </plugin>
      <plugin filename="GzSceneManager" name="Scene Manager">
        <gz-gui>
          <property key="resizable" type="bool">false</property>
          <property key="width" type="double">5</property>
          <property key="height" type="double">5</property>
          <property key="state" type="string">floating</property>
          <property key="showTitleBar" type="bool">false</property>
        </gz-gui>
      </plugin>
      <plugin filename="InteractiveViewControl" name="Interactive view control">
        <gz-gui>
          <property key="resizable" type="bool">false</property>
          <property key="width" type="double">5</property>
          <property key="height" type="double">5</property>
          <property key="state" type="string">floating</property>
          <property key="showTitleBar" type="bool">false</property>
        </gz-gui>
      </plugin>
      <plugin filename="CameraTracking" name="Camera Tracking">
        <gz-gui>
          <property key="resizable" type="bool">false</property>
          <property key="width" type="double">5</property>
          <property key="height" type="double">5</property>
          <property key="state" type="string">floating</property>
          <property key="showTitleBar" type="bool">false</property>
        </gz-gui>
      </plugin>
      <plugin filename="WorldControl" name="World control">
        <gz-gui>
          <property type="bool" key="showTitleBar">false</property>
          <property type="bool" key="resizable">false</property>
          <property type="double" key="height">72</property>
          <property type="double" key="z">1</property>
          <property type="string" key="state">floating</property>
          <anchors target="3D View">
            <line own="left" target="left" />
            <line own="bottom" target="bottom" />
          </anchors>
        </gz-gui>
        <play_pause>true</play_pause>
        <step>true</step>
        <start_paused>false</start_paused>
        <use_event>true</use_event>
      </plugin>
      </gui>

    <scene>
      <ambient>0.34 0.35 0.38 1</ambient>
      <background>0.02 0.025 0.035 1</background>
      <shadows>true</shadows>
    </scene>

    <light name="sun" type="directional">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0.4 0.2 -0.7</pose>
      <diffuse>0.9 0.88 0.82 1</diffuse>
      <specular>0.15 0.15 0.15 1</specular>
      <direction>-0.45 0.20 -0.87</direction>
    </light>

    <model name="lunar_regolith_plane">
      <static>true</static>
      <link name="ground">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>50 50</size>
            </plane>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>0.85</mu>
                <mu2>0.75</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>50 50</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.32 0.32 0.33 1</ambient>
            <diffuse>0.40 0.40 0.41 1</diffuse>
            <specular>0.05 0.05 0.05 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <model name="gentle_ramp">
      <static>true</static>
      <pose>4.0 0 0.18 0 0.18 0</pose>
      <link name="ramp">
        <collision name="collision">
          <geometry>
            <box>
              <size>2.8 1.6 0.28</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>2.8 1.6 0.28</size>
            </box>
          </geometry>
          <material>
            <ambient>0.36 0.35 0.33 1</ambient>
            <diffuse>0.46 0.45 0.42 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="rock_field_marker_a">
      <static>true</static>
      <pose>2.0 1.4 0.12 0 0 0.2</pose>
      <link name="rock">
        <collision name="collision">
          <geometry>
            <ellipsoid>
              <radii>0.32 0.24 0.20</radii>
            </ellipsoid>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <ellipsoid>
              <radii>0.32 0.24 0.20</radii>
            </ellipsoid>
          </geometry>
          <material>
            <ambient>0.30 0.30 0.29 1</ambient>
            <diffuse>0.38 0.37 0.35 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="rock_field_marker_b">
      <static>true</static>
      <pose>3.0 -1.1 0.09 0 0 0</pose>
      <link name="rock">
        <collision name="collision">
          <geometry>
            <ellipsoid>
              <radii>0.24 0.17 0.14</radii>
            </ellipsoid>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <ellipsoid>
              <radii>0.24 0.17 0.14</radii>
            </ellipsoid>
          </geometry>
          <material>
            <ambient>0.32 0.31 0.30 1</ambient>
            <diffuse>0.40 0.39 0.37 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="south_crater">
      <static>true</static>
      <pose>6.5 -4.5 0 0 0 0</pose>
      <link name="crater">
        <visual name="floor">
          <pose>0 0 0.012 0 0 0</pose>
          <geometry>
            <cylinder>
              <radius>1.45</radius>
              <length>0.018</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.12 0.13 0.15 1</ambient>
            <diffuse>0.17 0.18 0.20 1</diffuse>
          </material>
        </visual>
        <collision name="north_rim_collision">
          <pose>0 1.25 0.16 0 0 0</pose>
          <geometry>
            <ellipsoid><radii>0.82 0.34 0.22</radii></ellipsoid>
          </geometry>
        </collision>
        <visual name="north_rim">
          <pose>0 1.25 0.16 0 0 0</pose>
          <geometry>
            <ellipsoid><radii>0.82 0.34 0.22</radii></ellipsoid>
          </geometry>
          <material>
            <ambient>0.27 0.27 0.28 1</ambient>
            <diffuse>0.34 0.34 0.35 1</diffuse>
          </material>
        </visual>
        <collision name="south_rim_collision">
          <pose>0 -1.25 0.16 0 0 0</pose>
          <geometry>
            <ellipsoid><radii>0.82 0.34 0.22</radii></ellipsoid>
