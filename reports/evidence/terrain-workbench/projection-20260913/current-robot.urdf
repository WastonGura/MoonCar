      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <box size="0.075 0.10 0.055"/>
      </geometry>
      <material name="mooncar_light_gray"/>
    </visual>
    <visual name="camera_left_lens">
      <origin rpy="0 1.57079632679 0" xyz="0.0435 0.027 0"/>
      <geometry>
        <cylinder length="0.012" radius="0.014"/>
      </geometry>
      <material name="mooncar_lens_black"/>
    </visual>
    <visual name="camera_right_lens">
      <origin rpy="0 1.57079632679 0" xyz="0.0435 -0.027 0"/>
      <geometry>
        <cylinder length="0.012" radius="0.014"/>
      </geometry>
      <material name="mooncar_lens_black"/>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <box size="0.075 0.035 0.035"/>
      </geometry>
    </collision>
    <inertial>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <mass value="0.18"/>
      <inertia ixx="3.6750000000000006e-05" ixy="0.0" ixz="0.0" iyy="0.00010274999999999999" iyz="0.0" izz="0.00010274999999999999"/>
    </inertial>
  </link>
  <joint name="depth_camera_joint" type="fixed">
    <parent link="base_link"/>
    <child link="depth_camera_link"/>
    <origin rpy="0 0 0" xyz="0.39749999999999996 0 0.025"/>
  </joint>
  <link name="depth_camera_optical_frame"/>
  <joint name="depth_camera_optical_joint" type="fixed">
    <parent link="depth_camera_link"/>
    <child link="depth_camera_optical_frame"/>
    <origin rpy="-1.57079632679 0 -1.57079632679" xyz="0.0375 0 0"/>
  </joint>
  <link name="imu_link">
    <visual name="imu_module">
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <box size="0.035 0.035 0.035"/>
      </geometry>
      <material name="mooncar_warning_gold"/>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <box size="0.035 0.035 0.035"/>
      </geometry>
    </collision>
    <inertial>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <mass value="0.08"/>
      <inertia ixx="1.6333333333333335e-05" ixy="0.0" ixz="0.0" iyy="1.6333333333333335e-05" iyz="0.0" izz="1.6333333333333335e-05"/>
    </inertial>
  </link>
  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <origin rpy="0 0 0" xyz="0 0 0.1075"/>
  </joint>
  <link name="nav_reference_link">
    <visual name="antenna_base">
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <box size="0.04 0.04 0.04"/>
      </geometry>
      <material name="mooncar_warning_gold"/>
    </visual>
    <visual name="antenna_mast">
      <origin rpy="0 0 0" xyz="0 0 0.09"/>
      <geometry>
        <cylinder length="0.18" radius="0.012"/>
      </geometry>
      <material name="mooncar_hub_silver"/>
    </visual>
    <visual name="antenna_head">
      <origin rpy="0 0 0" xyz="0 0 0.19"/>
      <geometry>
        <sphere radius="0.032"/>
      </geometry>
      <material name="mooncar_sensor_blue"/>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <box size="0.04 0.04 0.04"/>
      </geometry>
    </collision>
    <inertial>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <mass value="0.05"/>
      <inertia ixx="1.3333333333333335e-05" ixy="0.0" ixz="0.0" iyy="1.3333333333333335e-05" iyz="0.0" izz="1.3333333333333335e-05"/>
    </inertial>
  </link>
  <joint name="nav_reference_joint" type="fixed">
    <parent link="base_link"/>
    <child link="nav_reference_link"/>
    <origin rpy="0 0 0" xyz="-0.16 0 0.11"/>
  </joint>
  <gazebo reference="lidar_link">
    <sensor name="mooncar_lidar" type="gpu_lidar">
      <pose>0 0 0.042499999999999996 0 0 0</pose>
      <always_on>true</always_on>
      <visualize>true</visualize>
      <update_rate>10</update_rate>
      <topic>/mooncar/scan</topic>
      <gz_frame_id>lidar_scan_frame</gz_frame_id>
      <ray>
        <scan>
          <horizontal>
            <samples>720</samples>
            <resolution>1</resolution>
            <min_angle>-3.14159</min_angle>
            <max_angle>3.14159</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.08</min>
          <max>12.0</max>
          <resolution>0.01</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.01</stddev>
        </noise>
      </ray>
    </sensor>
  </gazebo>
  <gazebo reference="depth_camera_link">
    <sensor name="mooncar_depth_camera" type="depth">
      <pose>0.0375 0 0 0 0 0</pose>
      <always_on>true</always_on>
      <visualize>true</visualize>
      <update_rate>10</update_rate>
      <topic>/mooncar/depth</topic>
      <gz_frame_id>depth_camera_optical_frame</gz_frame_id>
      <camera name="mooncar_depth_camera">
        <horizontal_fov>1.047</horizontal_fov>
        <image>
          <width>320</width>
          <height>240</height>
        </image>
        <clip>
          <near>0.05</near>
          <far>8.0</far>
        </clip>
        <depth_camera>
          <clip>
            <near>0.05</near>
            <far>8.0</far>
          </clip>
        </depth_camera>
      </camera>
    </sensor>
  </gazebo>
  <gazebo reference="imu_link">
    <sensor name="mooncar_imu" type="imu">
      <always_on>true</always_on>
      <update_rate>100</update_rate>
      <topic>/mooncar/imu</topic>
      <gz_frame_id>imu_link</gz_frame_id>
      <imu>
        <angular_velocity>
          <x>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>0.0002</stddev>
            </noise>
          </x>
          <y>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>0.0002</stddev>
            </noise>
          </y>
          <z>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>0.0002</stddev>
            </noise>
          </z>
        </angular_velocity>
        <linear_acceleration>
          <x>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>0.017</stddev>
            </noise>
          </x>
          <y>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>0.017</stddev>
            </noise>
          </y>
          <z>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>0.017</stddev>
            </noise>
          </z>
        </linear_acceleration>
      </imu>
    </sensor>
  </gazebo>
  <gazebo>
    <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
      <left_joint>front_left_wheel_joint</left_joint>
      <left_joint>rear_left_wheel_joint</left_joint>
      <right_joint>front_right_wheel_joint</right_joint>
      <right_joint>rear_right_wheel_joint</right_joint>
      <wheel_separation>0.59</wheel_separation>
      <wheel_radius>0.16</wheel_radius>
      <max_linear_acceleration>0.5</max_linear_acceleration>
      <min_linear_acceleration>-0.5</min_linear_acceleration>
      <max_angular_acceleration>1.0</max_angular_acceleration>
      <min_angular_acceleration>-1.0</min_angular_acceleration>
      <max_linear_velocity>0.35</max_linear_velocity>
      <min_linear_velocity>-0.35</min_linear_velocity>
      <max_angular_velocity>0.8</max_angular_velocity>
      <min_angular_velocity>-0.8</min_angular_velocity>
      <topic>/cmd_vel</topic>
      <odom_topic>/odom</odom_topic>
      <tf_topic>/tf</tf_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_footprint</child_frame_id>
      <odom_publish_frequency>30</odom_publish_frequency>
    </plugin>
    <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher">
      <joint_name>front_left_wheel_joint</joint_name>
      <joint_name>rear_left_wheel_joint</joint_name>
      <joint_name>front_right_wheel_joint</joint_name>
      <joint_name>rear_right_wheel_joint</joint_name>
      <topic>joint_states</topic>
      <update_rate>30</update_rate>
    </plugin>
  </gazebo>
</robot>

