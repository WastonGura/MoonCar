<?xml version="1.0" encoding="utf-8"?>
<sdf version="1.10">
  <world name="mooncar_survey_v2">
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics">
      <engine><filename>gz-physics-bullet-featherstone-plugin</filename></engine>
    </plugin>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>
    <physics name="mooncar_v2_physics" type="ode">
      <max_step_size>0.002</max_step_size><real_time_factor>1</real_time_factor>
    </physics>
    <gravity>0 0 -1.62</gravity>
    <scene><ambient>0.42 0.43 0.46</ambient><background>0.11 0.12 0.15</background></scene>
    <light type="directional" name="sun">
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.95 0.92 0.86 1</diffuse>
      <specular>0.20 0.20 0.20 1</specular>
      <direction>-0.45 -0.30 -0.84</direction>
    </light>
    <model name="ce4_crater_patch_ground">
      <static>true</static>
      <link name="surface">
        <collision name="terrain_collision">
          <geometry><mesh><uri>model://mooncar_gazebo/models/terrain_v2/survey/ce4_crater_patch.obj</uri></mesh></geometry>
          <surface><friction>
            <ode><mu>0.8</mu><mu2>0.72</mu2></ode>
            <bullet><friction>0.8</friction><friction2>0.72</friction2></bullet>
          </friction></surface>
        </collision>
        <visual name="terrain_visual">
          <geometry><mesh><uri>model://mooncar_gazebo/models/terrain_v2/survey/ce4_crater_patch.obj</uri></mesh></geometry>
          <material>
            <ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse>
            <pbr><metal>
              <albedo_map>model://mooncar_gazebo/materials/textures/regolith_passable_albedo.png</albedo_map>
              <normal_map>model://mooncar_gazebo/materials/textures/regolith_passable_normal.png</normal_map>
              <roughness_map>model://mooncar_gazebo/materials/textures/regolith_passable_roughness.png</roughness_map>
              <metalness>0.0</metalness>
            </metal></pbr>
          </material>
        </visual>
      </link>
    </model>
