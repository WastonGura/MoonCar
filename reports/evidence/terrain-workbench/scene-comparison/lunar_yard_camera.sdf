    <model name="scattered_rock_d">
      <static>true</static>
      <pose>-3.3 -2.2 0.12 -0.15 0.18 -0.4</pose>
      <link name="rock">
        <collision name="collision">
          <geometry><ellipsoid><radii>0.27 0.20 0.16</radii></ellipsoid></geometry>
