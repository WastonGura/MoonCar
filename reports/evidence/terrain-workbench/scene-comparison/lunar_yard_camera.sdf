          </geometry>
          <material>
            <ambient>0.27 0.27 0.28 1</ambient>
            <diffuse>0.34 0.34 0.35 1</diffuse>
          </material>
        </visual>
        <collision name="east_rim_collision">
          <pose>1.25 0 0.16 0 0 0</pose>
          <geometry>
            <ellipsoid><radii>0.34 0.82 0.22</radii></ellipsoid>
          </geometry>
        </collision>
        <visual name="east_rim">
          <pose>1.25 0 0.16 0 0 0</pose>
          <geometry>
            <ellipsoid><radii>0.34 0.82 0.22</radii></ellipsoid>
          </geometry>
          <material>
            <ambient>0.27 0.27 0.28 1</ambient>
            <diffuse>0.34 0.34 0.35 1</diffuse>
          </material>
        </visual>
        <collision name="west_rim_collision">
          <pose>-1.25 0 0.16 0 0 0</pose>
          <geometry>
            <ellipsoid><radii>0.34 0.82 0.22</radii></ellipsoid>
          </geometry>
        </collision>
        <visual name="west_rim">
          <pose>-1.25 0 0.16 0 0 0</pose>
          <geometry>
            <ellipsoid><radii>0.34 0.82 0.22</radii></ellipsoid>
          </geometry>
          <material>
            <ambient>0.27 0.27 0.28 1</ambient>
            <diffuse>0.34 0.34 0.35 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="north_ridge">
      <static>true</static>
      <pose>-6.0 4.5 0.24 0 0 -0.32</pose>
      <link name="ridge">
        <collision name="collision">
          <geometry>
            <ellipsoid><radii>2.4 0.65 0.38</radii></ellipsoid>
