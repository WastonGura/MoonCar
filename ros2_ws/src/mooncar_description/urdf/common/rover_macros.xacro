<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:macro name="wheel_tread" params="angle radius width">
    <visual>
      <origin
        xyz="${radius * sin(angle)} 0 ${radius * cos(angle)}"
        rpy="0 ${angle} 0"/>
      <geometry>
        <box size="${radius * 0.34} ${width + 0.018} 0.018"/>
      </geometry>
      <material name="mooncar_wheel_black"/>
    </visual>
  </xacro:macro>

  <xacro:macro name="skid_steer_wheel" params="prefix name parent x y z radius width mass">
    <link name="${prefix}${name}_link">
      <visual name="${name}_tire">
        <origin xyz="0 0 0" rpy="1.57079632679 0 0"/>
        <geometry>
          <cylinder radius="${radius}" length="${width}"/>
        </geometry>
        <material name="mooncar_wheel_black"/>
      </visual>
      <visual name="${name}_hub">
        <origin xyz="0 0 0" rpy="1.57079632679 0 0"/>
        <geometry>
          <cylinder radius="${radius * 0.48}" length="${width + 0.012}"/>
        </geometry>
        <material name="mooncar_hub_silver"/>
      </visual>
      <visual name="${name}_hub_cap">
        <origin xyz="0 0 0" rpy="1.57079632679 0 0"/>
        <geometry>
          <cylinder radius="${radius * 0.20}" length="${width + 0.020}"/>
        </geometry>
        <material name="mooncar_sensor_blue"/>
      </visual>
      <xacro:wheel_tread angle="0.0" radius="${radius + 0.006}" width="${width}"/>
      <xacro:wheel_tread angle="0.785398" radius="${radius + 0.006}" width="${width}"/>
      <xacro:wheel_tread angle="1.570796" radius="${radius + 0.006}" width="${width}"/>
      <xacro:wheel_tread angle="2.356194" radius="${radius + 0.006}" width="${width}"/>
      <xacro:wheel_tread angle="3.141593" radius="${radius + 0.006}" width="${width}"/>
      <xacro:wheel_tread angle="3.926991" radius="${radius + 0.006}" width="${width}"/>
      <xacro:wheel_tread angle="4.712389" radius="${radius + 0.006}" width="${width}"/>
      <xacro:wheel_tread angle="5.497787" radius="${radius + 0.006}" width="${width}"/>
      <collision>
        <origin xyz="0 0 0" rpy="1.57079632679 0 0"/>
        <geometry>
          <cylinder radius="${radius}" length="${width}"/>
        </geometry>
      </collision>
      <xacro:cylinder_inertial
        mass="${mass}"
        radius="${radius}"
        length="${width}"
        axis="y">
        <origin xyz="0 0 0" rpy="0 0 0"/>
      </xacro:cylinder_inertial>
    </link>

    <joint name="${prefix}${name}_joint" type="continuous">
      <parent link="${prefix}${parent}"/>
      <child link="${prefix}${name}_link"/>
      <origin xyz="${x} ${y} ${z}" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
      <dynamics damping="0.05" friction="0.0"/>
    </joint>
    <!-- Collision-local Z is the axle: skid steering needs lateral compliance.
         These are nominal simulator coefficients, not measured soil properties. -->
    <gazebo reference="${prefix}${name}_link">
      <fdir1>0 0 1</fdir1>
      <mu1>0.2</mu1>
      <mu2>0.85</mu2>
    </gazebo>
  </xacro:macro>
</robot>
