<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="mooncar_r5">
  <xacro:arg name="prefix" default=""/>
  <xacro:arg name="use_sim_time" default="true"/>
  <xacro:arg name="camera_sensor_profile" default="legacy"/>
  <!-- S3 reference target reflectivity: 10% -> 15 m; 2% -> 5 m, 70% -> 40 m.
       Gazebo's geometric lidar does not model reflectivity-dependent detection. -->
  <xacro:arg name="s3_max_range" default="15.0"/>
  <xacro:arg name="suspension_profile" default="rigid"/>

  <xacro:include filename="$(find mooncar_description)/urdf/common/materials.xacro"/>
  <xacro:include filename="$(find mooncar_description)/urdf/common/inertial_macros.xacro"/>
  <xacro:include filename="$(find mooncar_description)/urdf/common/rover_macros.xacro"/>
  <xacro:include filename="$(find mooncar_description)/urdf/common/gazebo_sensors.xacro"/>
  <xacro:include filename="$(find mooncar_description)/urdf/common/gazebo_drive.xacro"/>

  <xacro:include filename="$(find mooncar_description)/urdf/common/r5_suspension.xacro"/>

  <xacro:property name="prefix" value="$(arg prefix)"/>
  <!-- R5 proposal: 466 x 381.1 x 152 mm bare chassis and 152 mm tire diameter.
       TODO(hw:R5-GEOMETRY): track, wheelbase, wheel width and body geometry
       need drawings for the selected 24 V / 1:27 / four-wheel-drive chassis.
       TODO(hw:R5-MASS): weigh components and assembled center of gravity.
       The unconfirmed 5.7 kg bare-mass estimate is split into a 4.1 kg body
       and four 0.4 kg wheels for simulation only. -->
  <xacro:property name="chassis_length" value="0.32"/>
  <xacro:property name="chassis_width" value="0.25"/>
  <xacro:property name="chassis_height" value="0.08"/>
  <xacro:property name="chassis_mass" value="4.1"/>
  <xacro:property name="chassis_ground_clearance" value="0.06"/>
  <xacro:property name="wheel_radius" value="0.076"/>
  <xacro:property name="wheel_width" value="0.05"/>
  <xacro:property name="wheel_mass" value="0.4"/>
  <xacro:property name="wheel_x_offset" value="0.157"/>
  <xacro:property name="wheel_y_offset" value="0.16555"/>
  <xacro:property name="wheel_separation" value="${2.0 * wheel_y_offset}"/>
  <xacro:property name="base_link_z_offset" value="${chassis_ground_clearance + chassis_height / 2.0}"/>
  <xacro:property name="wheel_z_offset" value="${wheel_radius - base_link_z_offset}"/>
  <!-- SLAMTEC S3: 55.6 x 55.6 x 41.3 mm envelope, 115 g; cylinder approximation. -->
  <xacro:property name="lidar_radius" value="0.0278"/>
  <xacro:property name="lidar_height" value="0.0413"/>
  <xacro:property name="lidar_mass" value="0.115"/>
  <!-- OAK-D-Lite: width 91 mm, height 28 mm, thickness 17.5 mm, 61 g.
       Link axes: X forward/thickness, Y across camera/width, Z up/height. -->
  <xacro:property name="camera_length" value="0.0175"/>
  <xacro:property name="camera_width" value="0.091"/>
  <xacro:property name="camera_height" value="0.028"/>
  <xacro:property name="camera_mass" value="0.061"/>
  <!-- Procurement SEN0374 is a separate BNO055, not OAK's internal IMU.
       DFRobot SEN0374(V1.0) fabrication drawing, PDF pp.2/13/14:
       PCB footprint 19 x 21 mm, substrate thickness 1.0 mm.
       https://dfimg.dfrobot.com/wiki/21796/SEN0374_bno055-intelligent-9-axis-sensor_schematics_v1.pdf
       TODO(hw:IMU-PACKAGE): populated height and mass remain provisional;
       1 mm PCB thickness must not replace the total collision envelope. -->
  <xacro:property name="imu_length" value="0.019"/>
  <xacro:property name="imu_width" value="0.021"/>
  <xacro:property name="imu_pcb_thickness" value="0.001"/>
  <xacro:property name="imu_height" value="0.035"/>
  <xacro:property name="imu_mass" value="0.08"/>
  <xacro:property name="battery_length" value="0.177"/>
  <xacro:property name="battery_width" value="0.146"/>
  <xacro:property name="battery_height" value="0.078"/>
  <xacro:property name="battery_mass" value="3.05"/>

  <link name="${prefix}base_footprint"/>

  <joint name="${prefix}base_footprint_joint" type="fixed">
    <parent link="${prefix}base_footprint"/>
    <child link="${prefix}base_link"/>
    <origin xyz="0 0 ${base_link_z_offset}" rpy="0 0 0"/>
  </joint>

  <link name="${prefix}base_link">
    <visual name="lower_chassis">
      <origin xyz="0 0 -0.01" rpy="0 0 0"/>
      <geometry>
        <box size="${chassis_length} ${chassis_width} 0.06"/>
      </geometry>
      <material name="mooncar_dark_gray"/>
    </visual>
    <visual name="upper_equipment_deck">
      <origin xyz="0 0 0.042" rpy="0 0 0"/>
      <geometry>
        <box size="0.30 0.22 0.015"/>
      </geometry>
      <material name="mooncar_panel_white"/>
    </visual>
    <visual name="top_service_panel">
      <origin xyz="0.10 0 0.052" rpy="0 0 0"/>
      <geometry>
        <box size="0.075 0.15 0.006"/>
      </geometry>
      <material name="mooncar_sensor_blue"/>
    </visual>
    <visual name="left_frame_rail">
      <origin xyz="0 0.105 -0.018" rpy="0 0 0"/>
      <geometry>
        <box size="0.32 0.025 0.045"/>
      </geometry>
      <material name="mooncar_sensor_blue"/>
    </visual>
    <visual name="right_frame_rail">
      <origin xyz="0 -0.105 -0.018" rpy="0 0 0"/>
      <geometry>
        <box size="0.32 0.025 0.045"/>
      </geometry>
      <material name="mooncar_sensor_blue"/>
    </visual>
    <visual name="front_bumper">
      <origin xyz="0.165 0 -0.01" rpy="0 0 0"/>
      <geometry>
        <box size="0.015 0.24 0.025"/>
      </geometry>
      <material name="mooncar_hub_silver"/>
    </visual>
    <visual name="rear_bumper">
      <origin xyz="-0.165 0 -0.01" rpy="0 0 0"/>
      <geometry>
        <box size="0.015 0.24 0.025"/>
      </geometry>
      <material name="mooncar_hub_silver"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="${chassis_length} ${chassis_width} ${chassis_height}"/>
      </geometry>
    </collision>
    <xacro:box_inertial
      mass="${chassis_mass}"
      x="${chassis_length}"
      y="${chassis_width}"
      z="${chassis_height}">
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </xacro:box_inertial>
  </link>

  <link name="${prefix}battery_link">
    <visual name="p7120s_battery">
      <geometry>
        <box size="${battery_length} ${battery_width} ${battery_height}"/>
      </geometry>
      <material name="mooncar_dark_gray"/>
    </visual>
    <collision>
      <geometry>
        <box size="${battery_length} ${battery_width} ${battery_height}"/>
      </geometry>
    </collision>
    <xacro:box_inertial
      mass="${battery_mass}"
      x="${battery_length}"
      y="${battery_width}"
      z="${battery_height}">
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </xacro:box_inertial>
  </link>
  <joint name="${prefix}battery_joint" type="fixed">
    <parent link="${prefix}base_link"/>
    <child link="${prefix}battery_link"/>
    <!-- TODO(hw:MOUNTS): provisional battery installation, not a supplier drawing. -->
    <origin xyz="-0.035 0 0.088" rpy="0 0 0"/>
  </joint>

  <xacro:r5_supported_wheel
    prefix="${prefix}"
    name="front_left_wheel"
    parent="base_link"
    x="${wheel_x_offset}"
    y="${wheel_y_offset}"
    z="${wheel_z_offset}"
    radius="${wheel_radius}"
    width="${wheel_width}"
    mass="${wheel_mass}"
    tread_radius_offset="-0.008"
    tread_height="0.012"/>

  <xacro:r5_supported_wheel
    prefix="${prefix}"
    name="front_right_wheel"
    parent="base_link"
    x="${wheel_x_offset}"
    y="${-wheel_y_offset}"
    z="${wheel_z_offset}"
    radius="${wheel_radius}"
    width="${wheel_width}"
    mass="${wheel_mass}"
    tread_radius_offset="-0.008"
    tread_height="0.012"/>

  <xacro:r5_supported_wheel
    prefix="${prefix}"
    name="rear_left_wheel"
    parent="base_link"
    x="${-wheel_x_offset}"
    y="${wheel_y_offset}"
    z="${wheel_z_offset}"
    radius="${wheel_radius}"
    width="${wheel_width}"
    mass="${wheel_mass}"
    tread_radius_offset="-0.008"
    tread_height="0.012"/>

  <xacro:r5_supported_wheel
    prefix="${prefix}"
    name="rear_right_wheel"
    parent="base_link"
    x="${-wheel_x_offset}"
    y="${-wheel_y_offset}"
    z="${wheel_z_offset}"
    radius="${wheel_radius}"
    width="${wheel_width}"
    mass="${wheel_mass}"
    tread_radius_offset="-0.008"
    tread_height="0.012"/>

  <link name="${prefix}lidar_link">
    <visual name="lidar_housing">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="${lidar_radius}" length="${lidar_height}"/>
      </geometry>
      <material name="mooncar_sensor_blue"/>
    </visual>
    <visual name="lidar_mount">
      <origin xyz="0 0 -0.045" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.027" length="0.07"/>
      </geometry>
      <material name="mooncar_hub_silver"/>
    </visual>
    <visual name="lidar_top_cap">
      <origin xyz="0 0 ${lidar_height / 2.0 - 0.006}" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="${lidar_radius * 0.82}" length="0.012"/>
      </geometry>
      <material name="mooncar_lens_black"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="${lidar_radius}" length="${lidar_height}"/>
      </geometry>
    </collision>
    <xacro:cylinder_inertial
      mass="${lidar_mass}"
      radius="${lidar_radius}"
      length="${lidar_height}"
      axis="z">
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </xacro:cylinder_inertial>
  </link>

  <joint name="${prefix}lidar_joint" type="fixed">
    <parent link="${prefix}base_link"/>
    <child link="${prefix}lidar_link"/>
    <!-- TODO(hw:MOUNTS): body mounting and scan-plane offset need measurement. -->
    <origin xyz="0.11 0 ${chassis_height / 2.0 + lidar_height / 2.0}" rpy="0 0 0"/>
  </joint>

  <link name="${prefix}lidar_scan_frame"/>
  <joint name="${prefix}lidar_scan_joint" type="fixed">
    <parent link="${prefix}lidar_link"/>
    <child link="${prefix}lidar_scan_frame"/>
    <origin xyz="0 0 ${lidar_height / 2.0 + 0.02}" rpy="0 0 0"/>
  </joint>

  <!-- TODO(hw:GIMBAL): no actuator in the selected purchase list.
       Bracket geometry/mass, joint limits/dynamics and controller gains
       in gazebo_drive.xacro are research-model assumptions.
       TODO(hw:MOUNTS): lidar body/scan plane and camera mounting poses
       below need the actual installation drawing or measurement. -->
  <!-- 2-DOF Pan-Tilt Gimbal for Depth Camera -->
  <link name="${prefix}camera_mount_link">
    <visual name="camera_mount_mast">
      <origin xyz="0.01 0 -0.0525" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.01" length="0.105"/>
      </geometry>
      <material name="mooncar_dark_gray"/>
    </visual>
    <visual name="camera_mount_base">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.025" length="0.03"/>
      </geometry>
      <material name="mooncar_dark_gray"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.025" length="0.03"/>
      </geometry>
    </collision>
    <xacro:cylinder_inertial
      mass="0.08"
      radius="0.025"
      length="0.03"
      axis="z">
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </xacro:cylinder_inertial>
  </link>

  <joint name="${prefix}camera_mount_joint" type="fixed">
    <parent link="${prefix}base_link"/>
    <child link="${prefix}camera_mount_link"/>
    <!-- Elevated above lidar scan plane (z=0.201m) and battery top (z=0.227m)
         so full +/-135 deg gimbal pan clears chassis hardware. -->
    <origin xyz="${chassis_length / 2.0 - 0.02} 0 0.145" rpy="0 0 0"/>
  </joint>

  <link name="${prefix}camera_pan_link">
    <visual name="camera_pan_bracket">
      <origin xyz="0 0 0.015" rpy="0 0 0"/>
      <geometry>
        <box size="0.035 0.045 0.035"/>
      </geometry>
      <material name="mooncar_sensor_blue"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.015" rpy="0 0 0"/>
      <geometry>
        <box size="0.035 0.045 0.035"/>
      </geometry>
    </collision>
    <xacro:box_inertial
      mass="0.06"
      x="0.035"
      y="0.045"
      z="0.035">
      <origin xyz="0 0 0.015" rpy="0 0 0"/>
    </xacro:box_inertial>
  </link>

  <joint name="${prefix}camera_pan_joint" type="revolute">
    <parent link="${prefix}camera_mount_link"/>
    <child link="${prefix}camera_pan_link"/>
    <origin xyz="0 0 0.015" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-2.35619" upper="2.35619" effort="5.0" velocity="3.14159"/>
    <dynamics damping="0.05" friction="0.02"/>
  </joint>

  <link name="${prefix}camera_tilt_link">
    <visual name="camera_tilt_bracket">
      <origin xyz="0.01 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.03 0.05 0.025"/>
      </geometry>
      <material name="mooncar_hub_silver"/>
    </visual>
    <collision>
      <origin xyz="0.01 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.03 0.05 0.025"/>
      </geometry>
    </collision>
    <xacro:box_inertial
      mass="0.04"
      x="0.03"
      y="0.05"
      z="0.025">
      <origin xyz="0.01 0 0" rpy="0 0 0"/>
    </xacro:box_inertial>
  </link>

  <joint name="${prefix}camera_tilt_joint" type="revolute">
    <parent link="${prefix}camera_pan_link"/>
    <child link="${prefix}camera_tilt_link"/>
    <origin xyz="0.015 0 0.025" rpy="0 0 0"/>
    <axis xyz="0 -1 0"/>
    <limit lower="-0.610865" upper="0.261799" effort="5.0" velocity="3.14159"/>
    <dynamics damping="0.05" friction="0.02"/>
  </joint>

  <link name="${prefix}depth_camera_link">
    <visual name="camera_body">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="${camera_length} ${camera_width} ${camera_height}"/>
      </geometry>
      <material name="mooncar_light_gray"/>
    </visual>
    <visual name="camera_left_lens">
      <!-- Simplified front-panel lenses; 75 mm stereo baseline is visual only.
           No RGB/depth extrinsic calibration is inferred from this baseline. -->
      <origin xyz="${camera_length / 2.0 - 0.0005} 0.0375 0" rpy="0 1.57079632679 0"/>
      <geometry>
        <cylinder radius="0.0055" length="0.001"/>
      </geometry>
      <material name="mooncar_lens_black"/>
    </visual>
    <visual name="camera_right_lens">
      <origin xyz="${camera_length / 2.0 - 0.0005} -0.0375 0" rpy="0 1.57079632679 0"/>
      <geometry>
        <cylinder radius="0.0055" length="0.001"/>
      </geometry>
      <material name="mooncar_lens_black"/>
    </visual>
    <visual name="camera_rgb_lens">
      <origin xyz="${camera_length / 2.0 - 0.0005} 0 0" rpy="0 1.57079632679 0"/>
      <geometry>
        <cylinder radius="0.004" length="0.001"/>
      </geometry>
      <material name="mooncar_lens_black"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="${camera_length} ${camera_width} ${camera_height}"/>
      </geometry>
    </collision>
    <xacro:box_inertial
      mass="${camera_mass}"
      x="${camera_length}"
      y="${camera_width}"
      z="${camera_height}">
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </xacro:box_inertial>
  </link>

  <joint name="${prefix}depth_camera_joint" type="fixed">
    <parent link="${prefix}camera_tilt_link"/>
    <child link="${prefix}depth_camera_link"/>
    <origin xyz="${camera_length / 2.0 + 0.01} 0 0" rpy="0 0 0"/>
  </joint>

  <link name="${prefix}depth_camera_optical_frame"/>

  <joint name="${prefix}depth_camera_optical_joint" type="fixed">
    <parent link="${prefix}depth_camera_link"/>
    <child link="${prefix}depth_camera_optical_frame"/>
    <origin xyz="${camera_length / 2.0} 0 0" rpy="-1.57079632679 0 -1.57079632679"/>
  </joint>

  <link name="${prefix}rgb_camera_optical_frame"/>
  <joint name="${prefix}rgb_camera_optical_joint" type="fixed">
    <parent link="${prefix}depth_camera_link"/>
    <child link="${prefix}rgb_camera_optical_frame"/>
    <!-- TODO(hw:CAMERA-CALIBRATION): shared nominal optical origin.
         Read this device's factory calibration; also measure camera-to-body pose. -->
    <origin xyz="${camera_length / 2.0} 0 0" rpy="-1.57079632679 0 -1.57079632679"/>
  </joint>

  <link name="${prefix}imu_link">
    <!-- PCB visual only; populated components/headers are not modeled.
         Preserve the old mounting plane and provisional collision/inertia. -->
    <visual name="imu_pcb">
      <origin xyz="0 0 ${-imu_height / 2.0 + imu_pcb_thickness / 2.0}" rpy="0 0 0"/>
      <geometry>
        <box size="${imu_length} ${imu_width} ${imu_pcb_thickness}"/>
      </geometry>
      <material name="mooncar_warning_gold"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="${imu_length} ${imu_width} ${imu_height}"/>
      </geometry>
    </collision>
    <xacro:box_inertial
      mass="${imu_mass}"
      x="${imu_length}"
      y="${imu_width}"
      z="${imu_height}">
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </xacro:box_inertial>
  </link>

  <joint name="${prefix}imu_joint" type="fixed">
    <parent link="${prefix}base_link"/>
    <child link="${prefix}imu_link"/>
    <!-- TODO(hw:MOUNTS): sensor origin/axes and mounting pose are provisional. -->
    <origin xyz="0 0 ${chassis_height / 2.0 + imu_height / 2.0}" rpy="0 0 0"/>
  </joint>

  <!-- S3: nominal 32 kHz / 10 Hz = 3200 rays, uniform full-circle approximation.
       OAK: uncropped 480P stereo reference (73 deg), non-extended MinZ ~0.35 m.
       TODO(hw:CAMERA-CALIBRATION): CameraInfo is generated from this ideal
       pinhole, not factory intrinsics, distortion or stereo/RGB extrinsics.
       TODO(hw:UNMODELED-PAYLOAD): TFmini x4, Pi/control boards, cables and
       mounting hardware still need mass and placement; see docs/hardware_parameter_gaps.md. -->
  <xacro:mooncar_gazebo_sensors
    prefix="${prefix}" rgbd_camera="${dict(legacy=False, rgbd_v1=True)['$(arg camera_sensor_profile)']}"
    lidar_samples="3200" lidar_min_range="0.05"
    lidar_max_range="$(arg s3_max_range)" lidar_min_angle="${-pi}"
    lidar_max_angle="${pi - 2 * pi / 3200}"
    depth_hfov="${73 * pi / 180}" depth_width="640" depth_height="480"
    depth_min_range="0.35"/>
  <xacro:unless value="${'$(arg camera_sensor_profile)' == 'rgbd_v1'}">
    <gazebo reference="${prefix}depth_camera_link">
      <sensor name="mooncar_rgb_camera" type="camera">
        <pose>${camera_length / 2.0} 0 0 0 0 0</pose>
        <always_on>true</always_on>
        <update_rate>10</update_rate>
        <topic>/mooncar/rgb</topic>
        <gz_frame_id>${prefix}rgb_camera_optical_frame</gz_frame_id>
        <camera name="mooncar_rgb_camera">
          <camera_info_topic>/mooncar/rgb/camera_info</camera_info_topic>
          <horizontal_fov>${69 * pi / 180}</horizontal_fov>
          <image>
            <width>640</width>
            <height>480</height>
            <format>R8G8B8</format>
          </image>
          <clip><near>0.05</near><far>8.0</far></clip>
        </camera>
      </sensor>
    </gazebo>
  </xacro:unless>
  <xacro:mooncar_gazebo_drive
    prefix="${prefix}"
    joint_state_update_rate="${100 if '$(arg camera_sensor_profile)' == 'rgbd_v1' else 30}"
    suspension_profile="$(arg suspension_profile)"
    wheel_radius="${wheel_radius}"
    wheel_separation="${wheel_separation}"/>
</robot>
