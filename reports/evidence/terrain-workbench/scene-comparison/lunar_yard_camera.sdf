      <link name="north_middle">
        <pose>1 5.5 0.35 0 0 0.8</pose>
        <collision name="collision"><geometry><ellipsoid><radii>0.8 0.4 0.6</radii></ellipsoid></geometry></collision>
        <visual name="visual">
          <geometry><ellipsoid><radii>0.8 0.4 0.6</radii></ellipsoid></geometry>
