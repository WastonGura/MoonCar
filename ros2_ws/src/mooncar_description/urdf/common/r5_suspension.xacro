<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:macro name="r5_supported_wheel" params="prefix name parent x y z radius width mass tread_radius_offset tread_height">
    <xacro:if value="${'$(arg suspension_profile)' == 'rigid'}">
      <xacro:skid_steer_wheel prefix="${prefix}" name="${name}" parent="${parent}" x="${x}" y="${y}" z="${z}" radius="${radius}" width="${width}" mass="${mass}" tread_radius_offset="${tread_radius_offset}" tread_height="${tread_height}"/>
    </xacro:if>
    <xacro:unless value="${'$(arg suspension_profile)' == 'rigid'}">
      <xacro:property name="checked_profile" value="${dict(independent_linear_v1=True)['$(arg suspension_profile)']}"/>
      <xacro:property name="spring_force" value="${(2.924514673566879 if x > 0 else 3.220145326433121) if checked_profile else 0}"/>
      <xacro:property name="spring_k" value="${spring_force / 0.01}"/>
      <xacro:property name="spring_c" value="${2.0 * 0.7 * sqrt(spring_k * spring_force / 1.62)}"/>
      <!-- TODO(hw:R5-SUSPENSION): research approximation, not measured R5 hardware.
           Static loads derive from the frozen 9.186 kg model minus 4x0.4 kg
           unsprung mass. Travel +/-20 mm; unloaded reference -10 mm; zeta .7. -->
      <link name="${prefix}${name}_carrier_link">
        <xacro:cylinder_inertial mass="${mass / 8.0}" radius="${radius}" length="${width}" axis="y"><origin xyz="0 0 0" rpy="0 0 0"/></xacro:cylinder_inertial>
      </link>
      <joint name="${prefix}${name}_suspension_joint" type="prismatic">
        <parent link="${prefix}${parent}"/><child link="${prefix}${name}_carrier_link"/>
        <origin xyz="${x} ${y} ${z}" rpy="0 0 0"/><axis xyz="0 0 1"/>
        <limit lower="-0.02" upper="0.02" effort="50" velocity="0.5"/>
        <dynamics damping="${spring_c}" friction="0"/>
      </joint>
      <gazebo reference="${prefix}${name}_suspension_joint"><springReference>-0.01</springReference><springStiffness>${spring_k}</springStiffness></gazebo>
      <xacro:skid_steer_wheel prefix="${prefix}" name="${name}" parent="${name}_carrier_link" x="0" y="0" z="0" radius="${radius}" width="${width}" mass="${mass * 7.0 / 8.0}" tread_radius_offset="${tread_radius_offset}" tread_height="${tread_height}"/>
    </xacro:unless>
  </xacro:macro>
</robot>
