<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:macro name="mooncar_gazebo_sensors" params="prefix lidar_samples:=720 lidar_min_range:=0.08 lidar_max_range:=12.0 lidar_min_angle:=-3.14159 lidar_max_angle:=3.14159 depth_hfov:=1.047 depth_width:=320 depth_height:=240 depth_min_range:=0.05 rgbd_camera:=false">
    <!-- TODO(hw:MOUNTS): scan/camera offsets are nominal model poses.
         Output rates (lidar/depth 10 Hz, IMU 100 Hz) are selected operating
         modes; they are not measured delivery rates or maximum specifications. -->
    <gazebo reference="${prefix}lidar_link">
      <sensor name="mooncar_lidar" type="gpu_lidar">
        <pose>0 0 ${lidar_height / 2.0 + 0.02} 0 0 0</pose>
        <always_on>true</always_on>
        <visualize>true</visualize>
        <update_rate>10</update_rate>
        <topic>/mooncar/scan</topic>
        <gz_frame_id>${prefix}lidar_scan_frame</gz_frame_id>
        <ray>
          <scan>
            <horizontal>
              <samples>${lidar_samples}</samples>
              <resolution>1</resolution>
              <min_angle>${lidar_min_angle}</min_angle>
              <max_angle>${lidar_max_angle}</max_angle>
            </horizontal>
          </scan>
          <range>
            <min>${lidar_min_range}</min>
            <max>${lidar_max_range}</max>
            <resolution>0.01</resolution>
          </range>
          <!-- TODO(hw:SENSOR-NOISE): 0.01 m sigma is an uncalibrated assumption;
               manufacturer accuracy bounds are not Gaussian standard deviations. -->
          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.01</stddev>
          </noise>
        </ray>
      </sensor>
    </gazebo>

    <gazebo reference="${prefix}depth_camera_link">
      <sensor name="mooncar_depth_camera" type="${'rgbd_camera' if rgbd_camera else 'depth'}">
        <pose>${camera_length / 2.0} 0 0 0 0 0</pose>
        <always_on>true</always_on>
        <visualize>true</visualize>
        <update_rate>10</update_rate>
        <topic>${'/mooncar/localization_rgbd' if rgbd_camera else '/mooncar/depth'}</topic>
        <gz_frame_id>${prefix}depth_camera_optical_frame</gz_frame_id>
        <camera name="mooncar_depth_camera">
          <xacro:if value="${rgbd_camera}">
            <!-- Ideal aligned RGB/depth render, not device factory calibration. -->
            <optical_frame_id>${prefix}depth_camera_optical_frame</optical_frame_id>
          </xacro:if>
          <!-- TODO(hw:CAMERA-CALIBRATION): ideal depth camera, no binocular
               matching/occlusion, distortion or calibrated depth-error model.
               The 8 m far clip below is an application limit. -->
          <horizontal_fov>${depth_hfov}</horizontal_fov>
          <image>
            <width>${depth_width}</width>
            <height>${depth_height}</height>
          </image>
          <clip>
            <near>${depth_min_range}</near>
            <far>8.0</far>
          </clip>
          <depth_camera>
            <clip>
              <near>${depth_min_range}</near>
              <far>8.0</far>
            </clip>
          </depth_camera>
        </camera>
      </sensor>
    </gazebo>

    <gazebo reference="${prefix}imu_link">
      <sensor name="mooncar_imu" type="imu">
        <always_on>true</always_on>
        <update_rate>100</update_rate>
        <topic>/mooncar/imu</topic>
        <gz_frame_id>${prefix}imu_link</gz_frame_id>
        <!-- TODO(hw:SENSOR-NOISE): sigma 0.0002 rad/s and 0.017 m/s^2
             on all axes are placeholders; device noise/bias/drift need measurement. -->
        <imu>
          <angular_velocity>
            <x>
              <noise type="gaussian">
                <mean>0.0</mean>
                <stddev>0.0002</stddev>
              </noise>
            </x>
            <y>
              <noise type="gaussian">
                <mean>0.0</mean>
                <stddev>0.0002</stddev>
              </noise>
            </y>
            <z>
              <noise type="gaussian">
                <mean>0.0</mean>
                <stddev>0.0002</stddev>
              </noise>
            </z>
          </angular_velocity>
          <linear_acceleration>
            <x>
              <noise type="gaussian">
                <mean>0.0</mean>
                <stddev>0.017</stddev>
              </noise>
            </x>
            <y>
              <noise type="gaussian">
                <mean>0.0</mean>
                <stddev>0.017</stddev>
              </noise>
            </y>
            <z>
              <noise type="gaussian">
                <mean>0.0</mean>
                <stddev>0.017</stddev>
              </noise>
            </z>
          </linear_acceleration>
        </imu>
      </sensor>
    </gazebo>
  </xacro:macro>
</robot>
