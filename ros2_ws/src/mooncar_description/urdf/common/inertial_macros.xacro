<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:macro name="box_inertial" params="mass x y z *origin">
    <inertial>
      <xacro:insert_block name="origin"/>
      <mass value="${mass}"/>
      <inertia
        ixx="${mass * (y * y + z * z) / 12.0}"
        ixy="0.0"
        ixz="0.0"
        iyy="${mass * (x * x + z * z) / 12.0}"
        iyz="0.0"
        izz="${mass * (x * x + y * y) / 12.0}"/>
    </inertial>
  </xacro:macro>

  <xacro:macro name="cylinder_inertial" params="mass radius length axis *origin">
    <xacro:property name="i_axial" value="${0.5 * mass * radius * radius}"/>
    <xacro:property name="i_radial" value="${mass * (3.0 * radius * radius + length * length) / 12.0}"/>
    <inertial>
      <xacro:insert_block name="origin"/>
      <mass value="${mass}"/>
      <xacro:if value="${axis == 'x'}">
        <inertia ixx="${i_axial}" ixy="0.0" ixz="0.0" iyy="${i_radial}" iyz="0.0" izz="${i_radial}"/>
      </xacro:if>
      <xacro:if value="${axis == 'y'}">
        <inertia ixx="${i_radial}" ixy="0.0" ixz="0.0" iyy="${i_axial}" iyz="0.0" izz="${i_radial}"/>
      </xacro:if>
      <xacro:if value="${axis == 'z'}">
        <inertia ixx="${i_radial}" ixy="0.0" ixz="0.0" iyy="${i_radial}" iyz="0.0" izz="${i_axial}"/>
      </xacro:if>
    </inertial>
  </xacro:macro>
</robot>
