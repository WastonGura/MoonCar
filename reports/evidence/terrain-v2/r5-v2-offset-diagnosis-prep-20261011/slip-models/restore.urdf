       below need the actual installation drawing or measurement. -->
  <!-- 2-DOF Pan-Tilt Gimbal for Depth Camera -->
  <link name="camera_mount_link">
    <visual name="camera_mount_base">
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <cylinder length="0.03" radius="0.025"/>
      </geometry>
      <material name="mooncar_dark_gray"/>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <cylinder length="0.03" radius="0.025"/>
      </geometry>
    </collision>
    <inertial>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <mass value="0.08"/>
      <inertia ixx="1.8500000000000006e-05" ixy="0.0" ixz="0.0" iyy="1.8500000000000006e-05" iyz="0.0" izz="2.5e-05"/>
    </inertial>
  </link>
  <joint name="camera_mount_joint" type="fixed">
    <parent link="base_link"/>
    <child link="camera_mount_link"/>
    <origin rpy="0 0 0" xyz="0.14 0 0.04"/>
  </joint>
  <link name="camera_pan_link">
    <visual name="camera_pan_bracket">
      <origin rpy="0 0 0" xyz="0 0 0.015"/>
      <geometry>
        <box size="0.035 0.045 0.035"/>
      </geometry>
      <material name="mooncar_sensor_blue"/>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0.015"/>
      <geometry>
        <box size="0.035 0.045 0.035"/>
      </geometry>
    </collision>
    <inertial>
      <origin rpy="0 0 0" xyz="0 0 0.015"/>
      <mass value="0.06"/>
      <inertia ixx="1.625e-05" ixy="0.0" ixz="0.0" iyy="1.2250000000000001e-05" iyz="0.0" izz="1.625e-05"/>
    </inertial>
  </link>
  <joint name="camera_pan_joint" type="revolute">
    <parent link="camera_mount_link"/>
    <child link="camera_pan_link"/>
    <origin rpy="0 0 0" xyz="0 0 0.015"/>
    <axis xyz="0 0 1"/>
    <limit effort="5.0" lower="-2.35619" upper="2.35619" velocity="3.14159"/>
    <dynamics damping="0.05" friction="0.02"/>
  </joint>
  <link name="camera_tilt_link">
    <visual name="camera_tilt_bracket">
      <origin rpy="0 0 0" xyz="0.01 0 0"/>
      <geometry>
        <box size="0.03 0.05 0.025"/>
      </geometry>
      <material name="mooncar_hub_silver"/>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0.01 0 0"/>
      <geometry>
        <box size="0.03 0.05 0.025"/>
      </geometry>
    </collision>
    <inertial>
      <origin rpy="0 0 0" xyz="0.01 0 0"/>
      <mass value="0.04"/>
      <inertia ixx="1.041666666666667e-05" ixy="0.0" ixz="0.0" iyy="5.0833333333333335e-06" iyz="0.0" izz="1.1333333333333336e-05"/>
    </inertial>
  </link>
  <joint name="camera_tilt_joint" type="revolute">
    <parent link="camera_pan_link"/>
    <child link="camera_tilt_link"/>
    <origin rpy="0 0 0" xyz="0.015 0 0.025"/>
    <axis xyz="0 -1 0"/>
    <limit effort="5.0" lower="-0.610865" upper="0.261799" velocity="3.14159"/>
    <dynamics damping="0.05" friction="0.02"/>
  </joint>
  <link name="depth_camera_link">
    <visual name="camera_body">
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <box size="0.0175 0.091 0.028"/>
      </geometry>
      <material name="mooncar_light_gray"/>
    </visual>
    <visual name="camera_left_lens">
      <!-- Simplified front-panel lenses; 75 mm stereo baseline is visual only.
           No RGB/depth extrinsic calibration is inferred from this baseline. -->
      <origin rpy="0 1.57079632679 0" xyz="0.00825 0.0375 0"/>
      <geometry>
        <cylinder length="0.001" radius="0.0055"/>
      </geometry>
      <material name="mooncar_lens_black"/>
    </visual>
    <visual name="camera_right_lens">
      <origin rpy="0 1.57079632679 0" xyz="0.00825 -0.0375 0"/>
      <geometry>
        <cylinder length="0.001" radius="0.0055"/>
      </geometry>
      <material name="mooncar_lens_black"/>
    </visual>
    <visual name="camera_rgb_lens">
      <origin rpy="0 1.57079632679 0" xyz="0.00825 0 0"/>
      <geometry>
        <cylinder length="0.001" radius="0.004"/>
      </geometry>
      <material name="mooncar_lens_black"/>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <box size="0.0175 0.091 0.028"/>
      </geometry>
    </collision>
    <inertial>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <mass value="0.061"/>
      <inertia ixx="4.6080416666666663e-05" ixy="0.0" ixz="0.0" iyy="5.542104166666667e-06" iyz="0.0" izz="4.3651854166666664e-05"/>
    </inertial>
  </link>
  <joint name="depth_camera_joint" type="fixed">
    <parent link="camera_tilt_link"/>
    <child link="depth_camera_link"/>
    <origin rpy="0 0 0" xyz="0.018750000000000003 0 0"/>
  </joint>
  <link name="depth_camera_optical_frame"/>
  <joint name="depth_camera_optical_joint" type="fixed">
    <parent link="depth_camera_link"/>
    <child link="depth_camera_optical_frame"/>
    <origin rpy="-1.57079632679 0 -1.57079632679" xyz="0.00875 0 0"/>
  </joint>
  <link name="rgb_camera_optical_frame"/>
  <joint name="rgb_camera_optical_joint" type="fixed">
    <parent link="depth_camera_link"/>
    <child link="rgb_camera_optical_frame"/>
    <!-- TODO(hw:CAMERA-CALIBRATION): shared nominal optical origin.
         Read this device's factory calibration; also measure camera-to-body pose. -->
    <origin rpy="-1.57079632679 0 -1.57079632679" xyz="0.00875 0 0"/>
  </joint>
  <link name="imu_link">
    <!-- PCB visual only; populated components/headers are not modeled.
         Preserve the old mounting plane and provisional collision/inertia. -->
    <visual name="imu_pcb">
      <origin rpy="0 0 0" xyz="0 0 -0.017"/>
      <geometry>
        <box size="0.019 0.021 0.001"/>
      </geometry>
      <material name="mooncar_warning_gold"/>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <box size="0.019 0.021 0.035"/>
      </geometry>
    </collision>
    <inertial>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <mass value="0.08"/>
      <inertia ixx="1.1106666666666668e-05" ixy="0.0" ixz="0.0" iyy="1.0573333333333334e-05" iyz="0.0" izz="5.346666666666667e-06"/>
    </inertial>
  </link>
  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <!-- TODO(hw:MOUNTS): sensor origin/axes and mounting pose are provisional. -->
    <origin rpy="0 0 0" xyz="0 0 0.0575"/>
  </joint>
  <!-- TODO(hw:MOUNTS): scan/camera offsets are nominal model poses.
         Output rates (lidar/depth 10 Hz, IMU 100 Hz) are selected operating
         modes; they are not measured delivery rates or maximum specifications. -->
  <gazebo reference="lidar_link">
    <sensor name="mooncar_lidar" type="gpu_lidar">
      <pose>0 0 0.040650000000000006 0 0 0</pose>
      <always_on>true</always_on>
      <visualize>true</visualize>
      <update_rate>10</update_rate>
      <topic>/mooncar/scan</topic>
      <gz_frame_id>lidar_scan_frame</gz_frame_id>
      <ray>
        <scan>
          <horizontal>
            <samples>3200</samples>
            <resolution>1</resolution>
            <min_angle>-3.141592653589793</min_angle>
            <max_angle>3.1396291581812994</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.05</min>
          <max>15.0</max>
          <resolution>0.01</resolution>
        </range>
        <!-- TODO(hw:SENSOR-NOISE): 0.01 m sigma is an uncalibrated assumption;
               manufacturer accuracy bounds are not Gaussian standard deviations. -->
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.01</stddev>
        </noise>
      </ray>
    </sensor>
  </gazebo>
  <gazebo reference="depth_camera_link">
    <sensor name="mooncar_depth_camera" type="depth">
      <pose>0.00875 0 0 0 0 0</pose>
      <always_on>true</always_on>
      <visualize>true</visualize>
      <update_rate>10</update_rate>
      <topic>/mooncar/depth</topic>
      <gz_frame_id>depth_camera_optical_frame</gz_frame_id>
      <camera name="mooncar_depth_camera">
        <!-- TODO(hw:CAMERA-CALIBRATION): ideal depth camera, no binocular
               matching/occlusion, distortion or calibrated depth-error model.
               The 8 m far clip below is an application limit. -->
        <horizontal_fov>1.2740903539558606</horizontal_fov>
        <image>
          <width>640</width>
          <height>480</height>
        </image>
        <clip>
          <near>0.35</near>
          <far>8.0</far>
        </clip>
        <depth_camera>
          <clip>
            <near>0.35</near>
            <far>8.0</far>
          </clip>
        </depth_camera>
      </camera>
    </sensor>
  </gazebo>
  <gazebo reference="imu_link">
    <sensor name="mooncar_imu" type="imu">
      <always_on>true</always_on>
      <update_rate>100</update_rate>
      <topic>/mooncar/imu</topic>
      <gz_frame_id>imu_link</gz_frame_id>
      <!-- TODO(hw:SENSOR-NOISE): sigma 0.0002 rad/s and 0.017 m/s^2
             on all axes are placeholders; device noise/bias/drift need measurement. -->
      <imu>
        <angular_velocity>
          <x>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>0.0002</stddev>
            </noise>
          </x>
          <y>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>0.0002</stddev>
            </noise>
          </y>
          <z>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>0.0002</stddev>
            </noise>
          </z>
        </angular_velocity>
        <linear_acceleration>
          <x>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>0.017</stddev>
            </noise>
          </x>
          <y>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>0.017</stddev>
            </noise>
          </y>
          <z>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>0.017</stddev>
            </noise>
          </z>
        </linear_acceleration>
      </imu>
    </sensor>
  </gazebo>
  <gazebo reference="depth_camera_link">
    <sensor name="mooncar_rgb_camera" type="camera">
      <pose>0.00875 0 0 0 0 0</pose>
      <always_on>true</always_on>
      <update_rate>10</update_rate>
      <topic>/mooncar/rgb</topic>
      <gz_frame_id>rgb_camera_optical_frame</gz_frame_id>
      <camera name="mooncar_rgb_camera">
        <camera_info_topic>/mooncar/rgb/camera_info</camera_info_topic>
        <horizontal_fov>1.2042771838760873</horizontal_fov>
        <image>
          <width>640</width>
          <height>480</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.05</near>
          <far>8.0</far>
        </clip>
      </camera>
    </sensor>
  </gazebo>
  <gazebo>
    <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
      <left_joint>front_left_wheel_joint</left_joint>
      <left_joint>rear_left_wheel_joint</left_joint>
      <right_joint>front_right_wheel_joint</right_joint>
      <right_joint>rear_right_wheel_joint</right_joint>
      <wheel_separation>0.3311</wheel_separation>
      <wheel_radius>0.076</wheel_radius>
      <max_linear_acceleration>0.5</max_linear_acceleration>
      <min_linear_acceleration>-0.5</min_linear_acceleration>
      <max_angular_acceleration>1.0</max_angular_acceleration>
      <min_angular_acceleration>-1.0</min_angular_acceleration>
      <max_linear_velocity>0.35</max_linear_velocity>
      <min_linear_velocity>-0.35</min_linear_velocity>
      <max_angular_velocity>0.8</max_angular_velocity>
      <min_angular_velocity>-0.8</min_angular_velocity>
      <topic>/cmd_vel</topic>
      <odom_topic>/odom</odom_topic>
      <tf_topic>/tf</tf_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_footprint</child_frame_id>
      <odom_publish_frequency>30</odom_publish_frequency>
    </plugin>
    <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher">
      <joint_name>front_left_wheel_joint</joint_name>
      <joint_name>rear_left_wheel_joint</joint_name>
      <joint_name>front_right_wheel_joint</joint_name>
      <joint_name>rear_right_wheel_joint</joint_name>
      <joint_name>camera_pan_joint</joint_name>
      <joint_name>camera_tilt_joint</joint_name>
      <topic>joint_states</topic>
      <update_rate>30</update_rate>
    </plugin>
    <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
      <joint_name>camera_pan_joint</joint_name>
      <topic>/mooncar/cmd_camera_pan</topic>
      <p_gain>20.0</p_gain>
      <i_gain>0.1</i_gain>
      <d_gain>0.5</d_gain>
      <i_max>1.0</i_max>
      <i_min>-1.0</i_min>
      <cmd_max>5.0</cmd_max>
      <cmd_min>-5.0</cmd_min>
    </plugin>
    <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
      <joint_name>camera_tilt_joint</joint_name>
      <topic>/mooncar/cmd_camera_tilt</topic>
      <p_gain>20.0</p_gain>
      <i_gain>0.1</i_gain>
      <d_gain>0.5</d_gain>
      <i_max>1.0</i_max>
      <i_min>-1.0</i_min>
      <cmd_max>5.0</cmd_max>
      <cmd_min>-5.0</cmd_min>
    </plugin>
  </gazebo>
</robot>
