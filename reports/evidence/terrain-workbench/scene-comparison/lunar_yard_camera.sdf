    <model name="scattered_rock_e">
      <static>true</static>
      <pose>1.1 -3.4 0.09 0.12 0.08 0.3</pose>
      <link name="rock">
        <collision name="collision">
          <geometry><ellipsoid><radii>0.20 0.14 0.12</radii></ellipsoid></geometry>
        </collision>
        <visual name="visual">
          <geometry><ellipsoid><radii>0.20 0.14 0.12</radii></ellipsoid></geometry>
          <material>
            <ambient>0.22 0.23 0.24 1</ambient>
            <diffuse>0.30 0.31 0.32 1</diffuse>
