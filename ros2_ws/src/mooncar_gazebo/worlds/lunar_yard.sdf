<?xml version="1.0"?>
<sdf version="1.10">
  <world name="lunar_yard">
    <physics name="mooncar_physics" type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>

    <gravity>0 0 -1.62</gravity>

    <scene>
      <ambient>0.45 0.45 0.48 1</ambient>
      <background>0.02 0.025 0.035 1</background>
      <shadows>true</shadows>
    </scene>

    <light name="sun" type="directional">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0.4 0.2 -0.7</pose>
      <diffuse>0.9 0.88 0.82 1</diffuse>
      <specular>0.15 0.15 0.15 1</specular>
      <direction>-0.45 0.20 -0.87</direction>
    </light>

    <model name="lunar_regolith_plane">
      <static>true</static>
      <link name="ground">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>40 40</size>
            </plane>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>0.85</mu>
                <mu2>0.75</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>40 40</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.42 0.41 0.38 1</ambient>
            <diffuse>0.50 0.49 0.45 1</diffuse>
            <specular>0.05 0.05 0.05 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <model name="gentle_ramp">
      <static>true</static>
      <pose>4.0 0 0.18 0 0.18 0</pose>
      <link name="ramp">
        <collision name="collision">
          <geometry>
            <box>
              <size>2.8 1.6 0.28</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>2.8 1.6 0.28</size>
            </box>
          </geometry>
          <material>
            <ambient>0.36 0.35 0.33 1</ambient>
            <diffuse>0.46 0.45 0.42 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="rock_field_marker_a">
      <static>true</static>
      <pose>2.0 1.4 0.12 0 0 0.2</pose>
      <link name="rock">
        <collision name="collision">
          <geometry>
            <sphere>
              <radius>0.22</radius>
            </sphere>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <sphere>
              <radius>0.22</radius>
            </sphere>
          </geometry>
          <material>
            <ambient>0.30 0.30 0.29 1</ambient>
            <diffuse>0.38 0.37 0.35 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="rock_field_marker_b">
      <static>true</static>
      <pose>3.0 -1.1 0.09 0 0 0</pose>
      <link name="rock">
        <collision name="collision">
          <geometry>
            <sphere>
              <radius>0.17</radius>
            </sphere>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <sphere>
              <radius>0.17</radius>
            </sphere>
          </geometry>
          <material>
            <ambient>0.32 0.31 0.30 1</ambient>
            <diffuse>0.40 0.39 0.37 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
  </world>
</sdf>
